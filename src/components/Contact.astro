---
// Contact.astro - Footer / Contact CTA section
---
<section class="section contact-section" id="contact">
  <div class="container">
    <div class="contact-inner reveal">
      <div class="contact-content">
        <div class="section-label-row">
          <span class="gold-line"></span>
          <span class="t-label">Hablemos</span>
        </div>
        <h2 class="t-h1 contact-title">
          Ready to ship<br />
          something real?
        </h2>
        <p class="t-body-lg contact-desc">
          Tell us what you're building—or what's breaking.<br />
          We'll tell you honestly if and how we can help.
        </p>
        <div class="contact-options">
          <a
            href="https://cal.com/orlog/intro"
            class="btn btn-primary contact-btn"
            id="cta-schedule-call"
            target="_blank"
            rel="noopener noreferrer"
          >
            Schedule a 30-min call
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
          <a
            href="mailto:hola@orlog.dev"
            class="btn btn-ghost"
            id="cta-email"
          >
            hola@orlog.dev
          </a>
        </div>
        <p class="contact-note t-label">
          Typical response within 24 hours · No pitch decks, no fluff
        </p>
      </div>

      <div class="contact-divider" aria-hidden="true"></div>

      <div class="contact-info">
        <div class="info-block reveal reveal-delay-2">
          <span class="t-label">Engagement models</span>
          <ul class="info-list" role="list">
            <li>Project-based (fixed scope)</li>
            <li>Monthly retainer</li>
            <li>Fractional CTO</li>
          </ul>
        </div>
        <div class="info-block reveal reveal-delay-3">
          <span class="t-label">We work best with</span>
          <ul class="info-list" role="list">
            <li>Series A–C startups</li>
            <li>Ops-heavy SMEs</li>
            <li>Product teams needing surge capacity</li>
          </ul>
        </div>
        <div class="info-block reveal reveal-delay-4">
          <span class="t-label">Availability</span>
          <p class="info-status">
            <span class="status-dot" aria-label="Available"></span>
            Taking projects for Q1 2025
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="nav-logo" aria-label="Orlog home">
        <svg width="22" height="22" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <mask id="orlog-cut-footer">
            <rect width="28" height="28" fill="white" />
            <rect x="8.5" y="0" width="5" height="17" transform="rotate(45 11 17)" fill="black" />
          </mask>
          <circle cx="11" cy="17" r="7.5" stroke="#DFFF00" stroke-width="5" mask="url(#orlog-cut-footer)" />
          <rect x="19.25" y="5.25" width="3.5" height="3.5" transform="rotate(45 21 7)" fill="#DFFF00" />
        </svg>
        <span class="footer-brand-name">Orlog</span>
      </a>
      <p class="footer-tagline t-body">Engineering agency. Built for outcome.</p>
    </div>

    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="#work" class="footer-link">Work</a>
      <a href="#capabilities" class="footer-link">Capabilities</a>
      <a href="#philosophy" class="footer-link">Philosophy</a>
      <a href="mailto:hola@orlog.dev" class="footer-link">Contact</a>
    </nav>

    <div class="footer-bottom">
      <span class="t-label footer-copy">&copy; {new Date().getFullYear()} Orlog. All rights reserved.</span>
      <span class="t-label footer-loc">Remote-first · Global delivery</span>
    </div>
  </div>
</footer>

<style>
/* ─── Contact Section ────────────────────────────────────────────────── */
.contact-section {
  background: var(--c-bg-2);
  border-top: 1px solid var(--c-border);
}

.contact-inner {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 0;
  align-items: start;
}

.contact-content { padding-right: 5rem; }

.section-label-row { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 1.5rem; }
.contact-title { margin-bottom: 1rem; }
.contact-desc { max-width: 46ch; margin-bottom: 2rem; }

.contact-options {
  display: flex;
  align-items: center;
  gap: 0.875rem;
  flex-wrap: wrap;
  margin-bottom: 1.25rem;
}

.contact-btn { font-size: 0.9375rem; padding: 0.875rem 1.75rem; }

.contact-note {
  color: var(--c-text-3);
}

.contact-divider {
  width: 1px;
  background: var(--c-border);
  align-self: stretch;
  margin-block: 0;
}

.contact-info {
  padding-left: 5rem;
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
}

.info-block { display: flex; flex-direction: column; gap: 0.75rem; }
.info-block > .t-label { color: var(--c-text-3); }

.info-list {
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}
.info-list li {
  font-size: 0.9375rem;
  color: var(--c-text-2);
  padding-left: 1rem;
  position: relative;
}
.info-list li::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0.6em;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: var(--c-gold);
}

.info-status {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  font-size: 0.9375rem;
  color: var(--c-text-2);
}

.status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 0 3px rgba(34,197,94,0.2);
  animation: pulse 2.5s ease-in-out infinite;
  flex-shrink: 0;
}

@keyframes pulse {
  0%, 100% { box-shadow: 0 0 0 3px rgba(34,197,94,0.2); }
  50% { box-shadow: 0 0 0 6px rgba(34,197,94,0.1); }
}

/* ─── Footer ─────────────────────────────────────────────────────────── */
.footer {
  border-top: 1px solid var(--c-border);
  background: var(--c-bg);
  padding-block: 2.5rem;
}

.footer-inner {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 1.5rem;
  flex-wrap: wrap;
}

.nav-logo {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.footer-brand-name {
  font-family: var(--font-head);
  font-weight: 700;
  font-size: 1rem;
  letter-spacing: -0.02em;
}

.footer-tagline { font-size: 0.875rem; color: var(--c-text-3); }

.footer-nav {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
}

.footer-link {
  font-size: 0.875rem;
  color: var(--c-text-3);
  transition: color 200ms;
}
.footer-link:hover { color: var(--c-text); }

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 1.5rem;
  border-top: 1px solid var(--c-border);
  gap: 1rem;
  flex-wrap: wrap;
}

.footer-copy, .footer-loc { color: var(--c-text-3); }

@media (max-width: 900px) {
  .contact-inner { grid-template-columns: 1fr; }
  .contact-divider { width: 100%; height: 1px; margin-block: 3rem; }
  .contact-content { padding-right: 0; }
  .contact-info { padding-left: 0; }
}
</style>
