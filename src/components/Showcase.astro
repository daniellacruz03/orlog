</style>

<script>
import { projects, type Project } from '../data/projects';

/** Delay before returning to the idle manifesto after the cursor leaves. */
const RESET_DELAY = 650;

const root = document.querySelector<HTMLElement>('[data-showcase]');
if (root) initShowcase(root);

function initShowcase(root: HTMLElement) {
  // ── State ──────────────────────────────────────────────────────
  let activeProject: Project | null = null;
  let resetTimer: number | undefined;

  const byId = new Map(projects.map((p) => [p.id, p]));
  const targets = root.querySelectorAll<HTMLElement>('[data-project]');
  const pills = root.querySelectorAll<HTMLAnchorElement>('[data-pill]');
  const zones = root.querySelectorAll<HTMLElement>('[data-zone]');
  const pillNav = root.querySelector<HTMLElement>('.hs-pills');
  const mockup = root.querySelector<HTMLAnchorElement>('[data-mockup]');

  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  // ── Render: one pass that syncs DOM to state ───────────────────
  function setActive(next: Project | null) {
    if (next?.id === activeProject?.id) return;
    activeProject = next;

    root.dataset.state = next ? 'active' : 'idle';
    // keep the last accent + media while fading back to idle (no color flash)
    if (next) {
      root.style.setProperty('--accent', next.accent);
      root.dataset.media = next.brand ? 'brand' : 'browser';
      if (!next.brand && mockup) mockup.href = next.href;
    }

    targets.forEach((el) => el.toggleAttribute('data-on', el.dataset.project === next?.id));
    pills.forEach((el) => el.setAttribute('aria-current', String(el.dataset.project === next?.id)));
  }

  const cancelReset = () => window.clearTimeout(resetTimer);
  const scheduleReset = () => {
    cancelReset();
    resetTimer = window.setTimeout(() => setActive(null), RESET_DELAY);
  };
  const projectOf = (el: HTMLElement) => byId.get(el.dataset.project ?? '') ?? null;

  // ── Pointer (desktop hover) ────────────────────────────────────
  pills.forEach((pill) => {
    pill.addEventListener('pointerenter', (e) => {
      if (e.pointerType !== 'mouse') return;
      cancelReset();
      setActive(projectOf(pill));
    });

    // Touch / no-hover devices on wide screens: 1st tap previews, 2nd tap opens.
    pill.addEventListener('click', (e) => {
      if (canHover.matches) return;
      const p = projectOf(pill);
      if (p && activeProject?.id !== p.id) {
        e.preventDefault();
        setActive(p);
      }
    });

    // Keyboard
    pill.addEventListener('focus', () => {
      cancelReset();
      setActive(projectOf(pill));
    });
  });

  // List + mockup act as one "hover zone": moving between them keeps the state.
  zones.forEach((zone) => {
    zone.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') cancelReset(); });
    zone.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') scheduleReset(); });
  });

  pillNav?.addEventListener('focusout', (e) => {
    if (!pillNav.contains(e.relatedTarget as Node | null)) scheduleReset();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && activeProject) {
      (document.activeElement as HTMLElement | null)?.blur();
      setActive(null);
    }
  });

  // Tap outside (touch, wide screens) returns to idle.
  document.addEventListener('pointerdown', (e) => {
    if (canHover.matches || !activeProject) return;
    if (!(e.target as Element).closest('[data-zone]')) setActive(null);
  });

  // ── Subtle parallax (mockup tilt + background drift) ───────────
  if (canHover.matches && !reducedMotion.matches) {
    let raf = 0;
    root.addEventListener('pointermove', (e) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        const r = root.getBoundingClientRect();
        root.style.setProperty('--mx', (((e.clientX - r.left) / r.width) * 2 - 1).toFixed(3));
        root.style.setProperty('--my', (((e.clientY - r.top) / r.height) * 2 - 1).toFixed(3));
        raf = 0;
      });
    });
    root.addEventListener('pointerleave', () => {
      root.style.setProperty('--mx', '0');
      root.style.setProperty('--my', '0');
    });
  }
}
</script>
